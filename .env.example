# ─────────────────────────────────────────────
#  NEXUS-ENGINE — Variables de entorno
#  Copia este archivo a .env y llena los valores
# ─────────────────────────────────────────────

# ── Facebook Messenger & Instagram Direct (Meta API) ─────────────
FB_VERIFY_TOKEN=nexus_secret_verify_token
FB_PAGE_ACCESS_TOKEN=tu_facebook_page_access_token_aquilhost

# ── Base de datos MySQL (tu VPS) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=nexus_user
DB_PASSWORD=tu_password_aqui
DB_NAME=nexus_flow

# ── Información del negocio (Sección 1 del formulario) ───────────
# Aparece en los mensajes del bot y el dashboard
BUSINESS_NAME=Mi Negocio
# Número de WhatsApp del bot (con código de país, ej: +526861234567)
BOT_PHONE=+521XXXXXXXXXX
# Redes sociales o sitio web (opcional, el bot puede mencionarlo)
BUSINESS_SOCIAL=

# ── Personalidad del bot (Sección 5 del formulario) ──────────────
# Nombre del asistente virtual
BOT_NAME=Nexus
# Frase de bienvenida personalizada (vacío = usa la default del bot)
BOT_WELCOME_MSG=
# Tono del bot: formal | semiformal | casual
BOT_TONE=semiformal

# ── Reglas de agendamiento (Secciones 3.4 y 3.5) ─────────────────
# Horas mínimas de anticipación para poder agendar una cita
MIN_BOOKING_HOURS=2
# Días máximos en el futuro que el bot puede ofrecer
MAX_BOOKING_DAYS=30

# ── Reglas de cancelación (Sección 6.1 y 6.3) ────────────────────
# Horas mínimas de anticipación para poder cancelar
CANCEL_HOURS_LIMIT=24
# ¿El bot ofrece reagendar cuando el cliente cancela? (true/false)
OFFER_RESCHEDULE=true

# ── Personal / Empleados (Sección 4.2) ───────────────────────────
# ¿El cliente puede elegir con qué empleado quiere su cita? (true/false)
EMPLOYEE_SELECTION=false

# ── Puerto para la API de Nexus-Cockpit ──────────────────────────
API_PORT=3001

# ── Puerto del Webhook del bot (Cloud API) ────────────────────────
# Debe ser diferente al API_PORT. Meta necesita que sea alcanzable
# desde internet (usa ngrok en desarrollo o abre el puerto en el VPS)
WEBHOOK_PORT=3002

# ── WhatsApp Cloud API — Meta Business Platform ───────────────────
# Obtenlos en: https://developers.facebook.com → tu App → WhatsApp → API Setup
#
# Phone Number ID: el ID numérico del número registrado en Meta
WA_PHONE_NUMBER_ID=123456789012345
#
# Access Token: token "permanente" del sistema (System User Token)
# NO uses el token temporal de 24h que aparece en la consola de Meta
WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Verify Token: string secreto QUE TÚ DEFINES para verificar el webhook
# Ponlo igual en el campo "Verify Token" del panel de Meta
WA_VERIFY_TOKEN=nexus_webhook_secret_2024
#
# Versión de la Graph API (revisar la más reciente en Meta Docs)
WA_API_VERSION=v20.0

# ── Modo desarrollo sin VPS ──────────────────────────────────────
# true  → usa datos simulados en memoria (sin necesidad de MySQL)
# false → conecta a MySQL real (producción / VPS)
USE_MOCK_DB=false
